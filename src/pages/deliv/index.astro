---
import Legal from "../../layouts/Legal.astro";

const base = import.meta.env.BASE_URL;

const PLAY_STORE_URL = "https://play.google.com/store/apps/details?id=com.bluetechtg.deliv";
const APP_STORE_URL = "https://apps.apple.com/app/id0000000000";
---

<Legal
  frontmatter={{
    title: "Deliv",
    project: "Deliv",
    published: "September 16, 2026",
    updated: "November 9, 2026",
    description: "Deliv — Organize your delivery routes, packages and real earnings, simply.",
  }}
>
  <Fragment slot="hero">
    <div class="hero">
      <img class="icon" src={`${base}deliv/icon.png`} alt="" width="88" height="88" />
      <p class="tagline">
        Organize your delivery routes, packages and real earnings, simply.
      </p>
      <div class="badges">
        <a href={APP_STORE_URL} aria-label="Download on the App Store">
          <img src={`${base}deliv/apple-badge.svg`} alt="Download on the App Store" height="44" />
        </a>
        <a href={PLAY_STORE_URL} aria-label="Get it on Google Play">
          <img src={`${base}deliv/google-badge.png`} alt="Get it on Google Play" height="44" />
        </a>
      </div>
    </div>

    <div class="screenshots" role="list">
      {
        [
          ["01-accueil-mes-tournees.png", "Home screen: daily routes list"],
          ["02-fiche-tournee-colis.png", "Route overview: parcel checklist"],
          ["03-finances-benefice-net.png", "Finances: net profit overview"],
          ["04-marchands-relance.png", "Merchants & client list"],
          ["05-reglages-langue-fr-en.png", "Settings: language selection"],
        ].map(([file, alt]) => (
          <img
            role="listitem"
            class="screenshot"
            src={`${base}deliv/screenshots/${file}`}
            alt={alt}
            loading="lazy"
          />
        ))
      }
    </div>
  </Fragment>

  <p>
    Deliv is built for the independent delivery rider who is tired of juggling routes on WhatsApp,
    on paper, or from memory.
  </p>
  <p>
    No more scattered notes and rough end-of-day math: Deliv brings your routes, packages, clients,
    merchants, and real finances together in one place, right on your phone.
  </p>

  <h2>Routes & Packages</h2>
  <ul>
    <li>Create one route per day and add your packages (neighborhood, client, phone, location).</li>
    <li>Paste an order list received on WhatsApp: Deliv automatically splits it into packages.</li>
    <li>Check off each package as you deliver, flag an issue (client absent, address not found) without losing track.</li>
    <li>Reorder stops with easy drag-and-drop, or let Deliv calculate the optimal sequence.</li>
    <li>Open Google Maps or Waze directly for any destination.</li>
  </ul>

  <h2>Favorites & Merchants</h2>
  <ul>
    <li>Save frequent clients to fill in parcel details with a single tap.</li>
    <li>Link packages to merchants you deliver for, and see at a glance what balances are pending.</li>
    <li>Share a clean account statement with any merchant (instant image sharing).</li>
  </ul>

  <h2>Your Real Finances</h2>
  <ul>
    <li>Track delivery fees, operational expenses (fuel, data plans), and balances owed: real net profit, not guesswork.</li>
    <li>7-day and 30-day profitability charts.</li>
    <li>Daily targets and end-of-day reminders so nothing gets missed.</li>
  </ul>

  <h2>Built for the Field</h2>
  <ul>
    <li>Works offline for all daily tasks: your data stays on your phone, no account required.</li>
    <li>Instant search across packages, frequent clients, and merchants.</li>
    <li>Parcel photos and delivery proof records, invaluable in resolving disputes.</li>
    <li>Data export (Excel), local backup, and restoration.</li>
    <li>Fully bilingual in French and English.</li>
  </ul>

  <p>
    Deliv requires no subscription and has no hidden fees: it is a practical tool built for the
    daily reality of independent courier delivery.
  </p>

  <hr />
  <p>
    <a href={`${base}deliv/privacy/`}>Privacy Policy</a> · <a href={`${base}deliv/terms/`}>Terms of Service</a> · Contact:&nbsp;
    bluetechtg@gmail.com
  </p>
</Legal>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
    margin: 0.5rem 0 2rem;
  }

  .icon {
    border-radius: 22%;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15);
  }

  .tagline {
    color: var(--fg-muted);
    font-size: 1.05rem;
    max-width: 40ch;
    line-height: 1.5;
    margin: 0;
  }

  .badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .badges img {
    display: block;
    height: 44px;
    width: auto;
  }

  .screenshots {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.25rem 0 2rem;
    margin: 0 -1.5rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .screenshot {
    height: 340px;
    width: auto;
    flex-shrink: 0;
    border-radius: 14px;
    border: 1px solid var(--border);
    scroll-snap-align: start;
  }

  @media (max-width: 640px) {
    .screenshot {
      height: 280px;
    }
  }
</style>
