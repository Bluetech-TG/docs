---
import Legal from "../../layouts/Legal.astro";

const base = import.meta.env.BASE_URL;

const DEMO_URL = "https://gestionhotelapp.onrender.com/";
---

<Legal
  frontmatter={{
    title: "HotelPilot Suite",
    project: "HotelPilot Suite",
    published: "September 16, 2026",
    updated: "November 9, 2026",
    description: "HotelPilot Suite — All-in-one hospitality management platform (PMS) for hotels and residences.",
  }}
>
  <Fragment slot="hero">
    <div class="hero">
      <img class="icon" src={`${base}hotelpilot/icon.png`} alt="" width="88" height="88" />
      <p class="tagline">All-in-one hospitality management for modern hotels and residences.</p>
      <div class="actions">
        <a class="btn-demo" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
          Live Demo
        </a>
      </div>
    </div>
  </Fragment>

  <p>
    HotelPilot Suite is the Property Management System (PMS) built to simplify daily operations for
    hotels, boutique residences, and hospitality groups.
  </p>
  <p>
    From booking to check-out, room planning to invoicing, and staff handovers to stock control:
    everything is centralized in a modern web platform and companion mobile app.
  </p>

  <h2>Reservations & Stay Operations</h2>
  <ul>
    <li>Interactive visual room calendar with real-time room status (clean, occupied, maintenance).</li>
    <li>Fast check-in and check-out workflows with identity capture and automated guest folios.</li>
    <li>Group bookings, corporate accounts, and split billing support.</li>
  </ul>

  <h2>Billing & Accounting</h2>
  <ul>
    <li>Automated invoice generation, receipts, and extra charge tracking.</li>
    <li>Multi-currency support and compliant tax reporting (OHADA framework).</li>
    <li>Mobile Money and card payment processing.</li>
  </ul>

  <h2>Housekeeping & Stock</h2>
  <ul>
    <li>Room service and minibar restocking tracking.</li>
    <li>Real-time housekeeping task assignment and maintenance issue reporting.</li>
  </ul>

  <h2>Multi-Property Architecture</h2>
  <ul>
    <li>Manage multiple hotel properties from a single management console.</li>
    <li>Role-based access permissions for front desk, accounting, managers, and housekeeping.</li>
  </ul>

  <!-- HotelPilot Pulse Feature Card -->
  <section class="mobile-companion-card">
    <div class="companion-header">
      <img
        src={`${base}/hotelpilot/pulse-icon.png`}
        alt="HotelPilot Pulse Icon"
        class="companion-icon"
        width="64"
        height="64"
      />
      <div>
        <span class="companion-badge">Mobile Field Companion</span>
        <h2 class="companion-title">HotelPilot Pulse</h2>
      </div>
    </div>
    <p class="companion-desc">
      HotelPilot Suite extends beyond the reception desk. <strong>HotelPilot Pulse</strong> is the native mobile application designed for staff on the move: room cleaning checklist (dirty → clean → inspected), instant photo damage reports, key deposit tracking, mobile check-in/out, and offline corridor resilience.
    </p>
    <div class="companion-actions">
      <a href={`${base}/hotelpilot/pulse/`} class="btn-pulse">Explore Mobile App (HotelPilot Pulse) →</a>
      <a href={`${base}/hotelpilot/pulse/privacy/`} class="btn-pulse-sub">Pulse Privacy Policy</a>
      <a href={`${base}/hotelpilot/pulse/terms/`} class="btn-pulse-sub">Pulse Terms</a>
    </div>
  </section>

  <p>
    HotelPilot Suite is available as a cloud SaaS subscription, with online demo available.
  </p>

  <hr />
  <p>
    <a href={DEMO_URL}>Live Demo</a> ·
    <a href={`${base}/hotelpilot/pulse/`}>HotelPilot Pulse (Mobile)</a> ·
    <a href={`${base}/hotelpilot/privacy/`}>Privacy Policy</a> ·
    <a href={`${base}/hotelpilot/terms/`}>Terms of Service</a> ·
    Contact:&nbsp;bluetechtg@gmail.com
  </p>
</Legal>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
    margin: 0.5rem 0 2rem;
  }

  .icon {
    border-radius: 22%;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15);
  }

  .tagline {
    color: var(--fg-muted);
    font-size: 1.05rem;
    max-width: 40ch;
    line-height: 1.5;
    margin: 0;
  }

  .actions {
    margin-top: 0.5rem;
  }

  .btn-demo {
    display: inline-block;
    background: var(--accent);
    color: white;
    text-decoration: none;
    padding: 0.6rem 1.4rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .btn-demo:hover {
    opacity: 0.9;
  }

  /* Mobile companion highlight */
  .mobile-companion-card {
    background: color-mix(in srgb, var(--accent) 7%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    border-radius: 16px;
    padding: 1.6rem;
    margin: 2.5rem 0;
  }

  .companion-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .companion-icon {
    border-radius: 16px;
    box-shadow: 0 3px 10px rgba(32, 138, 239, 0.25);
    flex-shrink: 0;
  }

  .companion-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }

  .companion-title {
    margin: 0 !important;
    font-size: 1.35rem !important;
    letter-spacing: -0.01em;
  }

  .companion-desc {
    margin: 0 0 1.2rem !important;
    line-height: 1.6;
    color: var(--fg);
  }

  .companion-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-pulse {
    background: var(--accent);
    color: #ffffff !important;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    transition: opacity 0.15s;
  }

  .btn-pulse:hover { opacity: 0.9; }

  .btn-pulse-sub {
    color: var(--accent) !important;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.82rem;
    padding: 0.45rem 0.75rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    background: var(--bg);
  }

  .btn-pulse-sub:hover {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg));
  }
</style>
